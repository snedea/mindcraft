# Minecraft Server Connection
MINECRAFT_HOST=127.0.0.1
MINECRAFT_PORT=25565

# Mindcraft Web UI Port (accessible on server's localhost)
MINDSERVER_PORT=8080

# Bot Configuration
# You can override these to use multiple profiles
# PROFILES=["./andy.json"]

# Security Settings
INSECURE_CODING=true
# BLOCKED_ACTIONS=[]

# Performance Settings
MAX_MESSAGES=15
NUM_EXAMPLES=2
# LOG_ALL=false

# Optional: Claude API configuration (if not in andy.json)
# ANTHROPIC_API_KEY=your-api-key-here
